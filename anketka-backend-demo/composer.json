{
  "name": "anketka/backend-demo",
  "description": "Скелет бэкенда Анкетки для знакомства со стеком и подходом (без бизнес-логики)",
  "type": "project",
  "license": "proprietary",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "require": {
    "php": "~8.3.0",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "doctrine/migrations": "^3.0",
    "doctrine/orm": "^3.0",
    "laminas/laminas-config-aggregator": "^1.6",
    "laminas/laminas-diactoros": "^3.0.0",
    "laminas/laminas-servicemanager": "^3.22",
    "laminas/laminas-stdlib": "^3.6",
    "mezzio/mezzio": "^3.7",
    "mezzio/mezzio-helpers": "^5.7",
    "mezzio/mezzio-laminasrouter": "^3.9.0",
    "monolog/monolog": "^3.9",
    "ramsey/uuid": "^4.7",
    "symfony/cache": "^6.0",
    "symfony/config": "^6.0",
    "symfony/translation": "^6.0",
    "symfony/validator": "^6.4",
    "zircote/swagger-php": "^5.0"
  },
  "require-dev": {
    "filp/whoops": "^2.15.4",
    "laminas/laminas-development-mode": "^3.12.0",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^2.36",
    "vimeo/psalm": "^5.26"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/App/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": "@clear-config-cache",
    "post-update-cmd": "@clear-config-cache",
    "development-disable": "laminas-development-mode disable",
    "development-enable": "laminas-development-mode enable",
    "development-status": "laminas-development-mode status",
    "clear-config-cache": "php bin/clear-config-cache.php",
    "migrations:diff": "doctrine-migrations diff",
    "migrations:migrate": "doctrine-migrations migrate",
    "migrations:status": "doctrine-migrations status",
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "./vendor/bin/pest"
    ],
    "psalm": "./vendor/bin/psalm --no-cache"
  },
  "scripts-descriptions": {
    "clear-config-cache": "Clears merged config cache. Required for config changes to be applied."
  }
}
